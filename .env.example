# Password condivisa: hash scrypt "salt:key", mai la password in chiaro.
AUTH_PASSWORD_HASH=replace-with-hash

# Segreto per firmare il cookie di login (apri/chiudi il cancello).
AUTH_SECRET=replace-with-a-long-random-secret

# Bearer per cron/script (opzionale, non per le persone).
AUTH_BEARER_TOKEN=replace-with-another-random-token

# Opzionali
AUTH_COOKIE_NAME=app_auth
AUTH_MAX_AGE_DAYS=30
AUTH_REALM=Protected
