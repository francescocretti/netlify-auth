{
  "name": "@francescocretti/netlify-auth",
  "version": "1.0.0",
  "description": "A small shared-password authentication gate for Netlify Functions and React apps.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francescocretti/netlify-auth.git"
  },
  "homepage": "https://github.com/francescocretti/netlify-auth#readme",
  "bugs": "https://github.com/francescocretti/netlify-auth/issues",
  "keywords": [
    "netlify",
    "netlify-functions",
    "authentication",
    "react",
    "auth-gate"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "netlify",
    "dist",
    "ui/html",
    "hash-password.mjs",
    "init.mjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./netlify": {
      "types": "./netlify/index.d.mts",
      "import": "./netlify/index.mjs"
    },
    "./netlify/health": {
      "types": "./netlify/health.d.mts",
      "import": "./netlify/health.mjs"
    },
    "./netlify/login": {
      "types": "./netlify/login.d.mts",
      "import": "./netlify/login.mjs"
    },
    "./netlify/logout": {
      "types": "./netlify/logout.d.mts",
      "import": "./netlify/logout.mjs"
    },
    "./netlify/session": {
      "types": "./netlify/session.d.mts",
      "import": "./netlify/session.mjs"
    },
    "./react": {
      "types": "./dist/react/AuthGate.d.ts",
      "import": "./dist/react/AuthGate.js"
    },
    "./styles.css": "./dist/react/auth-gate.css",
    "./login.html": "./ui/html/login.html"
  },
  "bin": {
    "netlify-auth-hash": "./hash-password.mjs",
    "netlify-auth-init": "./init.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
